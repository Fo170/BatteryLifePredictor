    "SOH",
    "DOD",
    "EFC",
    "Miner",
    "Rainflow",
    "Kalman",
    "sulfatation",
    "plomb",
    "lithium",
    "LiFePO4",
    "IEC 61427",
    "aging",
    "degradation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Fo170/BatteryLifePredictor"
  },
  "authors": [
    {
      "name": "FOURNET Olivier",
      "email": "olivier.fournet@free.fr",
      "maintainer": true
    }
  ],
  "license": "GPL-3.0",
  "homepage": "https://github.com/Fo170/BatteryLifePredictor",
  "dependencies": {
    "Fo170/BatteryModels": "*",
    "Fo170/BatteryKalman": "*"
  },
  "frameworks": "arduino",
  "platforms": [
    "atmelavr",
    "espressif32",
    "ststm32",
    "teensy",
    "raspberrypi"
  ],
  "examples": [
    {
      "name": "Exemple complet v1.2.1",
